@page "/categories"
@rendermode InteractiveServer

@using InventoryHub.Contracts.Dtos
@using InventoryHub.Frontend.Services
@inject BackendClient Backend

<PageTitle>Categories — InventoryHub</PageTitle>

<h1>Categories</h1>
<p>Shared <code>CategoryRequest / CategoryResponse</code> DTOs with the API.</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="card mb-3">
    <div class="card-header">Add category</div>
    <div class="card-body d-flex gap-2">
        <input class="form-control" placeholder="Name" @bind="newName" />
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@busy">Add</button>
    </div>
</div>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <ul class="list-group">
        @foreach (var c in categories)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span><strong>#@c.Id</strong> @c.Name</span>
            </li>
        }
    </ul>
}

@code {
    private List<CategoryResponse> categories = [];
    private bool loading = true;
    private bool busy;
    private string? error;
    private string newName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Backend.GetCategoriesAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not reach the backend: {ex.Message}";
        }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newName)) { error = "Name is required."; return; }
        busy = true;
        try
        {
            var created = await Backend.CreateCategoryAsync(new CategoryRequest(newName.Trim()));
            categories.Add(created);
            newName = "";
            error = null;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
